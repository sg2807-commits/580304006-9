<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GestionITM.AppMovil.Views.LoginPage">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="GestionITM Login"
            FontSize="28"
            HorizontalOptions="Center"/>

        <Button
            x:Name="LoginButton"
            Text="Iniciar Sesión"
            Clicked="LoginButton_Clicked"/>

    </VerticalStackLayout>

</ContentPage>
